#!/usr/bin/env bash
set -eo pipefail
version="${VERSION:-dev}"
revision="${REVISION:-$(git rev-parse HEAD 2>/dev/null || echo unknown)}"
build_date="${BUILD_DATE:-$(git show -s --format=%cI HEAD 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)}"
pkg=github.com/grafana/beyla-k8s-injector/internal/buildinfo
go build -trimpath -ldflags="-s -w -X $pkg.Version=$version -X $pkg.Revision=$revision -X $pkg.Date=$build_date" -o "${LOCALBIN:-$PWD/bin}/manager" ./cmd
